{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build active C file",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "$outDir = Join-Path '${workspaceFolder}' '.build\\${relativeFileDirname}'; New-Item -ItemType Directory -Force -Path $outDir | Out-Null; & 'C:/mingw64/bin/gcc.exe' '-std=c17' '-Wall' '-Wextra' '-g' '${file}' '-o' (Join-Path $outDir '${fileBasenameNoExtension}.exe')"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "run active C file",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "& '${workspaceFolder}\\.build\\${relativeFileDirname}\\${fileBasenameNoExtension}.exe'"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "dependsOn": "build active C file",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true
            }
        }
    ]
}
